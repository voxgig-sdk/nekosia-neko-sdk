{
  "openapi": "3.0.3",
  "info": {
    "title": "Nekosia Neko API",
    "description": "Nekosia is a free API designed for integrating anime content, specifically featuring cute Neko images. It includes a dedicated Booru for browsing and adding images, enhancing project content with a variety of anime themes.",
    "version": "1.0.0",
    "contact": {
      "url": "https://nekosia.cat/documentation?page=introduction"
    }
  },
  "servers": [
    {
      "url": "https://nekosia.cat/api/v1",
      "description": "Production server"
    }
  ],
  "paths": {
    "/images/neko": {
      "get": {
        "summary": "Get random Neko image",
        "description": "Retrieve a random Neko (cat girl) anime image",
        "operationId": "getRandomNeko",
        "tags": [
          "Images"
        ],
        "parameters": [
          {
            "name": "count",
            "in": "query",
            "description": "Number of images to return",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 1,
              "minimum": 1,
              "maximum": 20
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "success"
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string"
                        },
                        "url": {
                          "type": "string",
                          "format": "uri"
                        },
                        "artist": {
                          "type": "string"
                        },
                        "source": {
                          "type": "string"
                        },
                        "tags": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
